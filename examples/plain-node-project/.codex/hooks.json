{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/evidence-layer/dist/bin/evidence-layer.mjs\" hook codex session-start",
            "commandWindows": "npx --no-install evidence-layer hook codex session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/evidence-layer/dist/bin/evidence-layer.mjs\" hook codex pre-tool-use",
            "commandWindows": "npx --no-install evidence-layer hook codex pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/evidence-layer/dist/bin/evidence-layer.mjs\" hook codex stop",
            "commandWindows": "npx --no-install evidence-layer hook codex stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
