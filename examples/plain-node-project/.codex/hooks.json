{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/evidence-layer-hook.mjs\" session-start --host=codex",
            "commandWindows": "npx --no-install evidence-layer hook codex session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/evidence-layer-hook.mjs\" pre-tool-use --host=codex",
            "commandWindows": "npx --no-install evidence-layer hook codex pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/evidence-layer-hook.mjs\" stop --host=codex",
            "commandWindows": "npx --no-install evidence-layer hook codex stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
